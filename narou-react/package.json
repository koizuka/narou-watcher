{
  "name": "narou-react",
  "version": "0.1.0",
  "homepage": "./",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "yarn": "please-use-npm"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.1.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "date-fns": "^4.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "scroll-into-view-if-needed": "^3.2.1",
    "swr": "^2.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "lint": "oxlint src",
    "typecheck": "tsc",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:visual": "cross-env BROWSER_TEST=true vitest",
    "test:visual:ci": "cross-env BROWSER_TEST=true vitest run",
    "test:visual:update": "cross-env BROWSER_TEST=true vitest run --update"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/browser": "^5.1.1",
    "@vitest/browser-playwright": "^5.0.0",
    "cross-env": "^10.1.0",
    "jest-environment-jsdom": "^30.5.2",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "playwright": "^1.65.1",
    "vitest": "^5.0.0",
    "vitest-browser-react": "^2.3.0",
    "whatwg-fetch": "^3.6.20"
  }
}
